# ─────────────────────────────────────────────────────────────────────────────
# OASIS environment configuration
#
#   cp .env.example .env      # then fill in GEMINI_API_KEY
#
# Only GEMINI_API_KEY is required. Everything else has a working default.
# Never commit your real .env file (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Google AI Studio key used for Gemma (text) and Gemini (vision) analysis.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── AI models (optional) ─────────────────────────────────────────────────────
# GEMMA_LLM_MODEL=gemma-4-31b-it
# GEMMA_LLM_FALLBACKS=gemma-3-27b-it,gemma-3-12b-it
# GEMINI_VLM_MODEL=gemini-2.5-flash
# true  = text-only analysis (photos are stored but not sent to the VLM)
# false = photos are also analysed by GEMINI_VLM_MODEL
# TEXT_ONLY_GEMMA_MODE=true

# ── Database (optional) ──────────────────────────────────────────────────────
# Change these before exposing the stack outside your machine.
# POSTGRES_DB=oasis
# POSTGRES_USER=oasis_user
# POSTGRES_PASSWORD=oasis_secret
# POSTGRES_PORT=5432

# ── Host ports (optional) ────────────────────────────────────────────────────
# API_PORT=8000
# DASHBOARD_PORT=4000
# MOBILE_APP_PORT=3000

# ── Web dashboard map layers (optional) ──────────────────────────────────────
# Google Photorealistic 3D Tiles (Map Tiles API). Without it the layer is disabled.
# GOOGLE_MAPS_API_KEY=
# Cesium ion token for "Cesium World Terrain". Without it CesiumJS' default token is used.
# CESIUM_ION_TOKEN=

# ── pgAdmin (optional, `docker compose --profile tools up`) ──────────────────
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=oasis_secret

# ── Cloudflare Tunnel (optional, `docker compose --profile tunnel up`) ──────
# CLOUDFLARE_TOKEN=
